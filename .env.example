# SynqForge environment template. Never commit secrets.
# Runtime app credential: restricted synqforge_app member.
DATABASE_URL=
# Migration credential: DDL-capable credential used only by an explicit release/migration job.
# Never configure this value in the web application runtime.
MIGRATION_DATABASE_URL=
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# AI provider selection: openai | anthropic | gemini | openai-compatible
AI_PROVIDER=
# Optional shared model fallback; provider-specific model variables take precedence.
AI_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_BASE_URL=
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_BASE_URL=
# For OpenAI-compatible endpoints only:
AI_API_KEY=
AI_BASE_URL=
